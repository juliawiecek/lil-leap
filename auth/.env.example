# Variable names match docker-compose.yml / Jenkinsfile's auth env wiring.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexttrade
DB_APP_USERNAME=app_user
DB_APP_PASSWORD=my_app_password

APP_JWT_SECRET=nexttrade-shared-dev-secret-32bytes-min
# Capped at SESSION_INACTIVITY_MINUTES
APP_JWT_EXPIRATION_MINUTES=10
APP_JWT_CLIENT_ID=nexttrade-web
# BR-03: sign out after this many minutes without a refresh
SESSION_INACTIVITY_MINUTES=10

NEXTTRADE_SECURITY_SSN_ENCRYPTION_KEY=

# Email (PS-08): outbox writes .eml files to PASSWORD_RESET_OUTBOX_DIR; smtp sends to Mailpit
# (inbox http://localhost:8025). The VM always uses outbox.
MAIL_DELIVERY=outbox
PASSWORD_RESET_OUTBOX_DIR=./outbox
SMTP_HOST=localhost
SMTP_PORT=1025
# Reset links open the dev frontend on :4300
PASSWORD_RESET_URL=http://localhost:4300/reset-password

PORT=8081
TLS_KEYSTORE=file:./certs/auth.p12
TLS_KEYSTORE_PASSWORD=
