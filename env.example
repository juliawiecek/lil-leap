# Local/demo placeholders only. Do not commit real shared secrets.
# Copy this file to .env, update values, then source it before running docker-compose.

# Database connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexttrade
DB_PUBLISHED_PORT=5432

# Database admin credentials (creates schema, runs migrations)
DB_ADMIN_USERNAME=main
DB_ADMIN_PASSWORD=replace_me

# Database application credentials (restricted role for Spring Boot)
DB_APP_USERNAME=app_user
DB_APP_PASSWORD=replace_me

# Security
SSN_ENCRYPTION_KEY=replace_me

# JWT signing secret (Demo/Education Only) — shared between auth and all backend services
# Must be at least 32 bytes for HMAC-SHA256
APP_JWT_SECRET=demo-shared-jwt-signing-secret-do-not-use-in-production-32bytes

# Application configuration
SESSION_INACTIVITY_MINUTES=10

# Synthetic US-equity quote service
QUOTE_PROVIDER=postgres
QUOTE_INTERVAL_SECONDS=5
QUOTE_PERIODS=10
QUOTE_SEED=42

# 0 means retain all quotes during MVP 
QUOTE_RETENTION_DAYS=0
QUOTE_SERVICE_PORT=8081