# Local/demo placeholders only. Do not commit real shared secrets.
# Copy this file to .env, update values, then source it before running docker-compose.

# Database connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexttrade

# Database admin credentials (creates schema, runs migrations)
DB_ADMIN_USERNAME=main
DB_ADMIN_PASSWORD=replace_me
POSTGRES_PASSWORD=replace_me

# Database application credentials (restricted role for Spring Boot)
DB_APP_USERNAME=app_user
DB_APP_PASSWORD=replace_me

# Security
SSN_ENCRYPTION_KEY=replace_me
# Shared by auth (signs JWTs) and orders/holdings/insights (verify them); 32+ bytes
APP_JWT_SECRET=nexttrade-shared-dev-secret-32bytes-min

# Application configuration
SESSION_INACTIVITY_MINUTES=10

# Synthetic US-equity quote service
QUOTE_PROVIDER=postgres
QUOTE_INTERVAL_SECONDS=5
QUOTE_PERIODS=10
QUOTE_SEED=42

# 0 means retain all quotes during MVP 
QUOTE_RETENTION_DAYS=0

# Reporting replica (separate SELECT-only application role)
REPORTING_DB_HOST=reporting-db
REPORTING_DB_USERNAME=reporting_user
REPORTING_DB_PASSWORD=replace_me
REPLICATION_PASSWORD=replace_me

# Optional TLS gateway override (docker-compose.tls.yml)
# TLS_CERTIFICATE_PATH=./certs/fullchain.pem
# TLS_PRIVATE_KEY_PATH=./certs/privkey.pem
