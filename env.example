# Local/demo placeholders only. Do not commit real shared secrets.
# Copy this file to .env, update values, then source it before running docker-compose.

# Database connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexttrade
DB_PUBLISHED_PORT=5432

# Database admin credentials (creates schema, runs migrations)
DB_ADMIN_USERNAME=main
DB_ADMIN_PASSWORD=replace_me

# Database application credentials (restricted role for Spring Boot)
DB_APP_USERNAME=app_user
DB_APP_PASSWORD=replace_me

# Security
SSN_ENCRYPTION_KEY=replace_me

# Application configuration
SESSION_INACTIVITY_MINUTES=10