{
  "all": true,
  "src": [
    "src"
  ],
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.d.ts"
  ],
  "extension": [
    ".ts"
  ],
  "reporter": [
    "text",
    "html",
    "lcovonly",
    "json-summary"
  ],
  "reports-dir": "coverage",
  "check-coverage": true,
  "per-file": false,
  "lines": 60,
  "statements": 60,
  "functions": 60,
  "branches": 60
}
