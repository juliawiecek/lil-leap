{
  "name": "nexttrade-angular",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "prestart": "ngc -p ../shared/session-core/tsconfig.json && node ../scripts/sync-session-core-dist.mjs && node scripts/build-colour-bootstrap.mjs && node ../scripts/build-assistive-bootstrap.mjs nexttrade.accessibility",
    "start": "ng serve --port 4300",
    "prebuild": "ngc -p ../shared/session-core/tsconfig.json && node ../scripts/sync-session-core-dist.mjs && node scripts/build-colour-bootstrap.mjs && node ../scripts/build-assistive-bootstrap.mjs nexttrade.accessibility",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs",
    "pretest": "ngc -p ../shared/session-core/tsconfig.json && node ../scripts/sync-session-core-dist.mjs",
    "pretest:coverage": "ngc -p ../shared/session-core/tsconfig.json && node ../scripts/sync-session-core-dist.mjs",
    "test:coverage": "c8 --reporter=text-summary --reporter=lcov --reporter=html --reports-dir=coverage node --enable-source-maps --test --test-concurrency=2 tests/*.test.mjs",
    "pretest:ci": "ngc -p ../shared/session-core/tsconfig.json && node ../scripts/sync-session-core-dist.mjs && node -e \"require('node:fs').mkdirSync('test-results', { recursive: true })\"",
    "test:ci": "node --test --test-concurrency=2 --test-reporter=spec --test-reporter=junit --test-reporter-destination=stdout --test-reporter-destination=test-results/security.xml tests/*.test.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test:e2e": "playwright test --config=playwright.config.mjs",
    "test:a11y": "playwright test --config=playwright.a11y.config.mjs",
    "test:e2e:auth":"node ../e2e/run-stack.mjs --project=auth"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@lilleap/session-core": "file:../shared/session-core",
    "rxjs": "7.8.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.0",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "c8": "^12.0.0",
    "happy-dom": "^20.14.5",
    "postcss": "8.5.31",
    "prettier": "^3.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
