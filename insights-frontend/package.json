{
  "name": "insights-frontend",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "prestart": "ngc -p ../shared/session-core/tsconfig.json && node ../scripts/sync-session-core-dist.mjs && node ../scripts/build-assistive-bootstrap.mjs nexttrade-insights.accessibility",
    "start": "ng serve",
    "prebuild": "ngc -p ../shared/session-core/tsconfig.json && node ../scripts/sync-session-core-dist.mjs && node ../scripts/build-assistive-bootstrap.mjs nexttrade-insights.accessibility",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs",
    "pretest": "ngc -p ../shared/session-core/tsconfig.json && node ../scripts/sync-session-core-dist.mjs",
    "pretest:coverage": "ngc -p ../shared/session-core/tsconfig.json && node ../scripts/sync-session-core-dist.mjs",
    "test:coverage": "c8 --reporter=text-summary --reporter=lcov --reporter=html --reports-dir=coverage node --enable-source-maps --test --test-concurrency=2 tests/*.test.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test:e2e:auth": "node ../e2e/run-stack.mjs --project=auth"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "@lilleap/session-core": "file:../shared/session-core"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.0",
    "c8": "^12.0.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
