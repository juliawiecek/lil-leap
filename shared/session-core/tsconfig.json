{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "experimentalDecorators": true
  },
  "angularCompilerOptions": {
    "compilationMode": "partial"
  },
  "include": [
    "src/**/*.ts"
  ]
}
