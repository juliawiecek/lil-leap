# Variable names match docker-compose.yml / Jenkinsfile's auth-service env wiring.

DB_HOST=db
DB_PORT=5432
DB_NAME=nexttrade
DB_APP_USERNAME=app_user
DB_APP_PASSWORD=my_app_password

APP_JWT_SECRET=dev-only-insecure-secret-change-me-before-deploying
APP_JWT_EXPIRATION_MINUTES=15
APP_JWT_CLIENT_ID=nexttrade-web
APP_REFRESH_EXPIRATION_DAYS=30

NEXTTRADE_SECURITY_SSN_ENCRYPTION_KEY=

PORT=3000
TLS_KEYSTORE=file:./certs/auth-service.p12
TLS_KEYSTORE_PASSWORD=
