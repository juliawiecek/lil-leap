# NextTrade Database Configuration
# Demo/Education Only - DO NOT USE IN PRODUCTION

# Database Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexttrade
DB_PUBLISHED_PORT=5432

# Database Admin Credentials (Demo/Education Only)
DB_ADMIN_USERNAME=main
DB_ADMIN_PASSWORD=nexttrade_admin_demo_123

# Database Application Credentials (Demo/Education Only)
DB_APP_USERNAME=app_user
DB_APP_PASSWORD=nexttrade_app_demo_456

# Security (Demo/Education Only - Not for Production)
SSN_ENCRYPTION_KEY=demo-pgp-encryption-key-do-not-use-production

# JWT signing secret (Demo/Education Only) — used by auth-service only.
# NextTrade backend and Insights backend verify tokens by calling auth-service's
# POST /verify over REST (see TS-DEVOPS-03) rather than parsing tokens locally,
# so they never need this secret. At least 32 bytes.
APP_JWT_SECRET=demo-shared-jwt-signing-secret-do-not-use-in-production-32bytes

# Application Configuration
SESSION_INACTIVITY_MINUTES=10
